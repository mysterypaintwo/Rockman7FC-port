#!/bin/bash
# Rockman 7 FC — settings window (window size, language, sound, keyboard and
# gamepad controls). Its Play button starts the game.
set -u
RES="$(cd "$(dirname "${BASH_SOURCE[0]}")/../Resources" && pwd)"
PORT_PLATFORM="macos"
PORT_RESOURCES="$RES"
PORT_SUPPORT_DIR="$HOME/Library/Application Support/Rockman7FC"
# shellcheck disable=SC1091
. "$RES/launcher-core.sh"
port_main settings
