// Rockman7FC.exe resources: icon, manifest, version info
#include <windows.h>
1 ICON "../../build/icons/rockman7fc.ico"
1 RT_MANIFEST "settings.manifest"
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Rockman 7 FC port settings and launcher"
      VALUE "ProductName", "Rockman 7 FC port"
      VALUE "FileVersion", "2.0"
      VALUE "ProductVersion", "2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
